# Copy to .env.local for development, and set the same values in the hosting
# provider's environment settings for preview and production.
#
# Without RESEND_API_KEY the forms will validate but refuse to report success:
# the API returns 503 and the visitor is told to email info@visiongoal.ch
# instead. Nothing is ever silently dropped.

# ---------------------------------------------------------------------------
# Email delivery (required)
# ---------------------------------------------------------------------------
# Create at https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. The domain must be verified in Resend before mail will send.
MAIL_FROM="Vision Goal <no-reply@visiongoal.ch>"

# ---------------------------------------------------------------------------
# Destinations (optional — each falls back to INBOX_DEFAULT)
# ---------------------------------------------------------------------------
INBOX_DEFAULT=info@visiongoal.ch
INBOX_APPLICATIONS=applications@visiongoal.ch
INBOX_CONSULTATIONS=info@visiongoal.ch
INBOX_INSTITUTIONAL=info@visiongoal.ch
INBOX_CONTACT=info@visiongoal.ch
INBOX_DOSSIER=info@visiongoal.ch
INBOX_NEWSLETTER=info@visiongoal.ch

# ---------------------------------------------------------------------------
# Dispatch double opt-in (required for the newsletter)
# ---------------------------------------------------------------------------
# Encrypts the subscriber address inside the confirmation link, so no personal
# data is legible in the URL and no database is needed to hold pending
# subscriptions. Must be at least 32 characters; the newsletter form will
# refuse to accept subscriptions without it. Generate one with:
#   openssl rand -base64 48
OPTIN_SECRET=

# Absolute base URL used to build the confirmation link. On Vercel this is
# inferred automatically; set it explicitly for a custom domain.
NEXT_PUBLIC_SITE_URL=https://visiongoal.ch

# ---------------------------------------------------------------------------
# Spam protection (optional)
# ---------------------------------------------------------------------------
# The honeypot field, the submission timing trap, and per-IP rate limiting are
# always active. Setting both Turnstile keys adds a Cloudflare challenge on top
# and enforces it server-side. Create at
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
